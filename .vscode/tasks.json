{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Build SDL2",
            "type": "shell",
            "command": "g++",
            "args": [
                "main.cpp",
                "-o",
                "app.exe",
                "-I/mingw64/include/SDL2",
                "-L/mingw64/lib",
                "-lSDL2main",
                "-lSDL2",
                "-mwindows"
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "problemMatcher": ["$gcc"]
        }
    ]
}
